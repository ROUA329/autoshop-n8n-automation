        "query": "INSERT INTO customers (full_name, email, phone, zone)\nVALUES (\n  '{{ $json.order.customer.full_name }}',\n  '{{ $json.order.customer.email }}',\n  '{{ $json.order.customer.phone }}',\n  '{{ $json.order.customer.zone }}'\n)\nRETURNING id;",
