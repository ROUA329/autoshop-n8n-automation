    {
      "parameters": {
        "jsCode": "const order = $('Validate Data').item.json.order;\n\n// Regex : détecte les motifs classiques d'injection SQL\nconst sqlPattern = /(\\bOR\\b|\\bAND\\b)\\s+['\"]?\\d+['\"]?\\s*=\\s*['\"]?\\d+|;\\s*(DROP|DELETE|UPDATE|INSERT|ALTER|TRUNCATE)|--|\\/\\*|\\bUNION\\b\\s+\\bSELECT\\b/i;\n\n// Liste des champs texte à vérifier\nconst fieldsToCheck = [\n  { name: 'customer.full_name', value: order.customer?.full_name },\n  { name: 'customer.email', value: order.customer?.email },\n  { name: 'customer.phone', value: order.customer?.phone },\n  { name: 'order_code', value: order.order_code }\n];\n\n// On ajoute aussi les product_code de chaque item\nif (order.items && Array.isArray(order.items)) {\n  order.items.forEach((item, index) => {\n    fieldsToCheck.push({\n      name: `items[${index}].product_code`,\n      value: item.product_code\n    });\n  });\n}\n\n// Scan de chaque champ\nfor (const field of fieldsToCheck) {\n  if (field.value && sqlPattern.test(field.value)) {\n    return [{\n      json: {\n        threat_detected: true,\n        matched_field: field.name,\n        matched_value: field.value,\n        order_code: order.order_code || null\n      }\n    }];\n  }\n}\n\n// Aucune menace trouvée\nreturn [{\n  json: {\n    threat_detected: false,\n    order: order\n  }\n}];"
      },
