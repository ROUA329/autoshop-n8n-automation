    {
      "parameters": {
        "jsCode": "const body = $json.body;\n\nif (body.callback_query) {\n  const callbackQuery = body.callback_query;\n  const callbackData = callbackQuery.data;\n  const chatId = callbackQuery.message.chat.id;\n  const messageId = callbackQuery.message.message_id;\n\n  // Livreur clique Shipped ou Delivered\n  if (callbackData.startsWith('ship_') || callbackData.startsWith('deliver_')) {\n    const orderCode = callbackData.replace('ship_', '').replace('deliver_', '');\n    const newStatus = callbackData.startsWith('ship_') ? 'shipped' : 'delivered';\n    return [{\n      json: {\n        type: 'agent_delivery_update',\n        order_code: orderCode,\n        delivery_status: newStatus,\n        chat_id: chatId\n      }\n    }];\n  }\n\n  // Client clique YES ou NO\n  const isConfirmed = callbackData.startsWith('confirm_');\n  const orderCode = callbackData.replace('confirm_', '').replace('cancel_', '');\n  return [{\n    json: {\n      type: 'client_confirmation',\n      order_code: orderCode,\n      chat_id: chatId,\n      message_id: messageId,\n      confirmed: isConfirmed,\n      callback_data: callbackData\n    }\n  }];\n}\n\nif (body.message) {\n  const message = body.message;\n  const text = message.text;\n  const chatId = message.chat.id;\n\n  if (text && text.startsWith('/start ')) {\n    const payload = text.replace('/start ', '').trim();\n    if (payload.startsWith('AGENT-')) {\n      const agentId = payload.replace('AGENT-', '').trim();\n      return [{\n        json: {\n          type: 'agent_link',\n          agent_id: agentId,\n          chat_id: chatId\n        }\n      }];\n    }\n    return [{\n      json: {\n        type: 'telegram_link',\n        order_code: payload,\n        chat_id: chatId\n      }\n    }];\n  }\n  return [{ json: { type: 'unknown', raw: body } }];\n}\n\nreturn [{ json: { type: 'unknown', raw: body } }];"
      },
